{
  "name": "how-about-me",
  "version": "0.0.1",
  "private": true,
  "description": "How About Me — Threads social listening & content intelligence (MVP monorepo)",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:int": "turbo run test:int",
    "test:int:quiet": "bash scripts/test-int-quiet.sh",
    "clean": "turbo run clean && rm -rf node_modules/.cache .turbo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci:local": "pnpm --filter @how-about-me/api prisma:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm audit:check",
    "verify": "pnpm --filter @how-about-me/api prisma:generate && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm agent:test",
    "verify:quiet": "bash scripts/verify-quiet.sh",
    "git:check-base": "bash scripts/check-base-branch.sh",
    "agent": "node scripts/agent.mjs",
    "agent:test": "node --test scripts/agent-workflow.test.mjs scripts/pr-done.test.mjs scripts/pr-conventions.test.mjs scripts/merge-state.test.mjs scripts/verify-lock.test.mjs scripts/verify-stamp.test.mjs scripts/fe-secrets.test.mjs scripts/audit-check.test.mjs",
    "issue:start": "node scripts/issue.mjs start",
    "issue:tidy": "node scripts/issue.mjs tidy",
    "issue:shot": "node scripts/issue.mjs shot",
    "issue:ship": "node scripts/issue.mjs ship",
    "issue:finish": "node scripts/issue.mjs finish",
    "pr:create": "node scripts/pr-create.mjs",
    "pr:check": "node scripts/pr-create.mjs --check-only",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @how-about-me/api db:migrate",
    "db:deploy": "pnpm --filter @how-about-me/api db:deploy",
    "db:seed": "pnpm --filter @how-about-me/api db:seed",
    "db:seed:demo": "pnpm --filter @how-about-me/api db:seed:demo",
    "db:reset": "pnpm --filter @how-about-me/api db:reset",
    "db:studio": "pnpm --filter @how-about-me/api db:studio",
    "backlog:render": "node scripts/backlog/render-wbs.mjs",
    "issues:sync": "node scripts/github/sync-issues.mjs",
    "check:fe-secrets": "node scripts/check-fe-secrets.mjs",
    "audit:check": "node scripts/audit-check.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml,mjs,cjs,js,css}": "prettier --write --ignore-unknown"
  },
  "pnpm": {
    "overrides": {
      "multer@<2.4.0": "^2.4.0",
      "proxy-addr@<2.0.8": "^2.0.8",
      "sharp@<0.35.5": "^0.35.5",
      "postcss@<8.5.23": "^8.5.23",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "deepmerge-ts@<8.0.0": "^8.0.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "@parcel/watcher"
    ]
  }
}
