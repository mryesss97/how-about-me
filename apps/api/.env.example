# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ROLE=all                     # api | worker | all
PORT=4000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ── Database (local Docker: pnpm db:up) ─────────────────────────────────────
# Supabase: DATABASE_URL = pooler (port 6543) + ?pgbouncer=true&connection_limit=10 ; DIRECT_URL = port 5432   # REQUIRED
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/how_about_me?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/how_about_me?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/how_about_me_test?schema=public

# ── Supabase Auth (owner input) ──────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co          # REQUIRED
# One of the two verification methods (JWKS preferred):
SUPABASE_JWKS_URL=                                       # default ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=                                     # HS256 legacy projects only
SUPABASE_SERVICE_ROLE_KEY=                               # server-only; invites & seed:auth-user (never in web)
SEED_ADMIN_EMAIL=admin@example.com                       # first admin membership (pnpm db:seed)

# ── Secrets encryption (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ──
INTEGRATION_ENCRYPTION_KEYS={"k1":"REPLACE_WITH_BASE64_32_BYTES"}   # REQUIRED
INTEGRATION_ENCRYPTION_ACTIVE_KEY=k1

# ── Providers ────────────────────────────────────────────────────────────────
PROVIDERS_MODE=fake              # fake | real
THREADS_API_BASE_URL=https://graph.threads.net/v1.0
THREADS_REQUEST_TIMEOUT_MS=15000
THREADS_APP_ID=                  # owner input (if OAuth flow is used)
THREADS_APP_SECRET=              # owner input
OPENAI_API_KEY=                  # owner input (real mode)
SAFETY_PROVIDER=openai
SAFETY_MODEL=omni-moderation-latest
ANALYSIS_CLASSIFIER_PROVIDER=openai
ANALYSIS_CLASSIFIER_MODEL=       # owner input (real mode)
ANALYSIS_PRICE_INPUT_PER_1M=0
ANALYSIS_PRICE_OUTPUT_PER_1M=0
ANALYSIS_BRAND_CONTEXT=1Zone and Eventista are Vietnamese live-event, ticketing and fan-membership brands.

# ── Collector (docs/02-architecture/06-ingestion-pipeline.md §10) ────────────
COLLECTOR_TICK_MS=60000
COLLECTOR_MAX_CONCURRENT_QUERIES=3
COLLECTOR_MAX_PAGES_PER_JOB=50
COLLECTOR_PAGE_LIMIT=50
COLLECTOR_MAX_RETRIES=3
COLLECTOR_LOCK_STALE_MINUTES=15
COLLECTOR_MAX_WINDOW_DAYS=30
COLLECTOR_MAX_BACKFILL_DAYS=30
COLLECTOR_CIRCUIT_FAILURE_THRESHOLD=5
COLLECTOR_CIRCUIT_OPEN_SECONDS=600

# ── Analysis (docs/02-architecture/07-analysis-pipeline.md §11) ──────────────
ANALYSIS_POLL_MS=5000
ANALYSIS_BATCH_SIZE=20
ANALYSIS_CONCURRENCY=3
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_TWO_STEP=false
ANALYSIS_SKIP_SUMMARY_FOR_SPAM=true
ANALYSIS_DAILY_BUDGET_USD=5
ANALYSIS_BULK_MAX=2000

# ── Misc ─────────────────────────────────────────────────────────────────────
EXPORT_MAX_ROWS=10000
METRICS_TOKEN=
RETENTION_POSTS_DAYS=365
RETENTION_RUNS_DAYS=365
RETENTION_SYNC_JOBS_DAYS=180
