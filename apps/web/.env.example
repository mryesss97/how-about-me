# Public (safe for browser) — owner input for Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co      # REQUIRED
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>                         # REQUIRED (anon key only — NEVER service role)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
NEXT_PUBLIC_APP_ENV=local
# Optional: enable Google sign-in button when the provider is configured in Supabase
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
